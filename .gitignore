__pycache__/
.cache/
*.py[cod]
.DS_Store
.venv/
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# 本地环境与敏感信息
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器与临时文件
.vscode/
.idea/
*.swp
*.tmp
*.log
.drawio-tmp/
tmp/

# 论文候选稿和重复分页证明在本地归档；Git保留源稿、稳定正式Word及轻量审计。
# 已跟踪的历史交付文件继续保留，不因新增忽略规则而删除。
docs/thesis/**/*.docx
docs/thesis/**/*.pdf
docs/thesis/**/visual-qa*/**/*.png
docs/thesis/**/visual-qa*/**/*.jpg
docs/thesis/**/lo-visual-audit*/**/*.png
docs/thesis/**/lo-visual-audit*/**/*.jpg
docs/thesis/**/detail-previews/*.png
docs/thesis/**/*.jsonl

# 原始、中间及正式数据不进入 Git；仅保留目录骨架与轻量清单
data/external/*
data/interim/*
data/processed/*
!data/external/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# 模型检查点、张量与预测工件由实验归档管理
*.pt
*.pth
*.ckpt
*.onnx
*.npz

# 实验输出不进入 Git
outputs/*
!outputs/.gitkeep
# 论文图例外：SVG/PNG 双格式入仓（可追溯 + 供审查），其余 outputs 一律忽略
!outputs/figures/
!outputs/figures/*.svg
!outputs/figures/*.png
# 正式论文只保留一个稳定文件名，历史版本由 Git 管理。
!outputs/thesis/
outputs/thesis/*
!outputs/thesis/基于站内多关系图与机制诊断的充电节点短期负荷预测研究_正式论文.docx
# 调试脚本残留图不入仓（visualize_adaptive_graph.py 输出，已由正式图取代）
outputs/figures/fig_adaptive_graph_heatmaps.*
outputs/figures/fig_alpha_curve.*
# 未纳入正文的早期示意图源稿留在本地，不进入版本库
outputs/figures/schematics/
# 本地保留的图片替换前快照不进入版本库；正式版本由根目录图件和 manifest 锁定。
outputs/figures/archive-before-*/
outputs/figures/archive/
