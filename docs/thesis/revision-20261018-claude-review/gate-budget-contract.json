  "implementation_gaps": [
    {
      "id": "GAP-01",
      "item": "现有Caltech门控入口不能加载JPL数据",
      "detail": "scripts/gate_control_experiment.py固定使用FrozenData、Caltech DATA_SHA256、SG-DATA-006协议和data/eventtime/dataset.npz，未提供JPL数据路径或协议切换。"
    },
    {
      "id": "GAP-02",
      "item": "现有JPL入口不支持共享门控配置",
      "detail": "scripts/jpl_relation_controls.py可加载FrozenJPLData，但只构造full/load_to_self/event_to_self/pattern_to_self四种关系替换，未构造mrg_shared_gate，也未提供两配置配对运行路径。"
    },
    {
      "id": "GAP-03",
      "item": "需要JPL门控入口与作用域工厂适配",
      "detail": "需新建或扩展入口，使runner.build_model在专用CLI进程内注入mrg_full与mrg_shared_gate，退出时恢复；直接修改旧runner或旧上传包不在本任务范围内。"
    },
    {
      "id": "GAP-04",
      "item": "需要配对初始化与合同检查",
      "detail": "需实现check阶段：两种子配置参数均为32,714；同种子初始参数SHA-256一致；关系图、数据、切分和批次顺序一致；梯度有限且非零；探针后参数不变；CUDA环境与合同冻结。"
    },
    {
      "id": "GAP-05",
      "item": "需要非零目标评价",
      "detail": "runner.export的metric_report只直接给出整体、RMSE、事件/稳定组及目标事件×规则触发四格，未直接输出非零目标MAE。需在入口或导出后审计中从predictions_test.npz的y_true计算target != 0分层，并保持原始导出不变。"
    },
    {
      "id": "GAP-06",
      "item": "需要配对块统计",
      "detail": "runner不包含bootstrap。需新增预登记审计脚本，在共同测试键上按固定JPL测试期的连续七日块计算两配置逐键绝对误差差的10,000次配对bootstrap区间；统计脚本须在测试导出前冻结哈希。"
    },
    {
      "id": "GAP-07",
      "item": "需要源码与bundle哈希覆盖",
      "detail": "runner.code_digest只覆盖eventtime/*.py和models目录中的部分文件，未覆盖jpl_eventtime/data.py或新入口。需在运行合同中另行记录JPL加载器、新入口、配置和计划哈希，并创建冻结bundle manifest。"
    },
    {
      "id": "GAP-08",
      "item": "需要回收与关机流程",
      "detail": "需准备启动包装、结果归档哈希、6/6合同核验、独立指标复算和控制面关机证据；关机只能在回收验收后执行，不以SSH断连作为关机证明。"
    }
